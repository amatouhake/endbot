{
  "name": "endbot-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The Endbot web: a Cloudflare Worker relay, a Durable Object and a Svelte UI. See docs/WEB.md.",
  "license": "Apache-2.0",
  "scripts": {
    "generate": "node scripts/generate-protocol.mjs",
    "check": "npm run generate && tsc --noEmit && svelte-check --tsconfig ./tsconfig.ui.json",
