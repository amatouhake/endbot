        "y": "integer",
        "z": "integer",
        "dimension": "string",
        "from": "block",
        "to": "block",
        "cause": "string",
        "bot": "string?"
      },
      "guarantee": {
        "class": "persist",
        "ticks": 4,
        "each": [
          "player-break",
          "player-place"
