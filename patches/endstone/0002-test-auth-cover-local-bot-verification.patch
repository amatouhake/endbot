+#include <gtest/gtest.h>
+
+#include "bedrock/network/base_connection_request.h"
+
+namespace {
+
+class TestConnectionRequest final : public BaseConnectionRequest {
+private:
+    bool _isAuthTypeWellFormed() const override { return false; }
+};
+
+TEST(BaseConnectionRequestTest, MissingRawTokenIsReportedWithoutDereference)
+{
+    // A decoded Login can contain a request object before BDS has established
+    // that its optional raw token is present. Local auth must be able to test
+    // this state safely and leave rejection to the stock validator.
+    TestConnectionRequest request;
+    EXPECT_EQ(request._getRawRequest(), nullptr);
+}
+
+}  // namespace
diff --git a/tests/test_local_bot_auth.cpp b/tests/test_local_bot_auth.cpp
new file mode 100644
index 000000000..0c5fe13a6
--- /dev/null
+++ b/tests/test_local_bot_auth.cpp
@@ -0,0 +1,234 @@
+// Copyright (c) 2026, The Endstone Project contributors.
+// SPDX-License-Identifier: Apache-2.0
+
+#include <chrono>
+#include <filesystem>
+#include <fstream>
+#include <memory>
+#include <string>
+#include <vector>
+
+#include <gtest/gtest.h>
+#include <nlohmann/json.hpp>
+#include <openssl/bn.h>
+#include <openssl/ec.h>
+#include <openssl/evp.h>
+#include <openssl/pem.h>
+#include <openssl/x509.h>
+
+#include "endstone/runtime/local_bot_auth.h"
+
+namespace {
+
+using Json = nlohmann::json;
+using PkeyPtr = std::unique_ptr<EVP_PKEY, decltype(&EVP_PKEY_free)>;
+using MdCtxPtr = std::unique_ptr<EVP_MD_CTX, decltype(&EVP_MD_CTX_free)>;
+using EcdsaSigPtr = std::unique_ptr<ECDSA_SIG, decltype(&ECDSA_SIG_free)>;
+constexpr auto kNow = 1'800'000'000;
+
+PkeyPtr makeKey()
+{
+    auto *context = EVP_PKEY_CTX_new_from_name(nullptr, "EC", nullptr);
+    EXPECT_NE(context, nullptr);
+    EXPECT_EQ(EVP_PKEY_keygen_init(context), 1);
+    EXPECT_EQ(EVP_PKEY_CTX_set_group_name(context, "secp384r1"), 1);
+    EVP_PKEY *key = nullptr;
+    EXPECT_EQ(EVP_PKEY_generate(context, &key), 1);
+    EVP_PKEY_CTX_free(context);
+    return {key, EVP_PKEY_free};
+}
+
+std::string base64Url(const unsigned char *data, std::size_t length)
+{
+    std::string encoded(4 * ((length + 2) / 3), '\0');
+    const auto size = EVP_EncodeBlock(reinterpret_cast<unsigned char *>(encoded.data()), data, static_cast<int>(length));
+    encoded.resize(size);
+    while (!encoded.empty() && encoded.back() == '=') encoded.pop_back();
+    for (auto &c : encoded) {
+        if (c == '+') c = '-';
+        else if (c == '/') c = '_';
+    }
+    return encoded;
+}
+
+std::string publicKeyBase64(EVP_PKEY *key)
+{
+    const auto size = i2d_PUBKEY(key, nullptr);
+    std::vector<unsigned char> der(size);
+    auto *position = der.data();
+    EXPECT_EQ(i2d_PUBKEY(key, &position), size);
+    return base64Url(der.data(), der.size());
+}
+
+std::string signJwt(const Json &payload, EVP_PKEY *key)
+{
+    const auto header = base64Url(reinterpret_cast<const unsigned char *>(R"({"alg":"ES384","kid":"endbot-local"})"),
+                                  std::string_view(R"({"alg":"ES384","kid":"endbot-local"})").size());
+    const auto body_text = payload.dump();
+    const auto body = base64Url(reinterpret_cast<const unsigned char *>(body_text.data()), body_text.size());
+    const auto input = header + "." + body;
+
+    MdCtxPtr context(EVP_MD_CTX_new(), EVP_MD_CTX_free);
+    EXPECT_EQ(EVP_DigestSignInit(context.get(), nullptr, EVP_sha384(), nullptr, key), 1);
+    std::size_t der_size = 0;
+    EXPECT_EQ(EVP_DigestSign(context.get(), nullptr, &der_size,
+                             reinterpret_cast<const unsigned char *>(input.data()), input.size()), 1);
+    std::vector<unsigned char> der(der_size);
+    EXPECT_EQ(EVP_DigestSign(context.get(), der.data(), &der_size,
+                             reinterpret_cast<const unsigned char *>(input.data()), input.size()), 1);
+    der.resize(der_size);
+    const unsigned char *position = der.data();
+    EcdsaSigPtr signature(d2i_ECDSA_SIG(nullptr, &position, static_cast<long>(der.size())), ECDSA_SIG_free);
+    EXPECT_NE(signature, nullptr);
+    const BIGNUM *r = nullptr;
+    const BIGNUM *s = nullptr;
+    ECDSA_SIG_get0(signature.get(), &r, &s);
+    std::vector<unsigned char> raw(96);
+    EXPECT_EQ(BN_bn2binpad(r, raw.data(), 48), 48);
+    EXPECT_EQ(BN_bn2binpad(s, raw.data() + 48, 48), 48);
+    return input + "." + base64Url(raw.data(), raw.size());
+}
+
+struct Fixture {
+    Fixture()
+        : owner(makeKey()), client(makeKey()), alternate(makeKey()),
+          directory(std::filesystem::temp_directory_path() /
+                    ("endstone-local-bot-" + std::to_string(reinterpret_cast<std::uintptr_t>(this)))),
+          public_key_path(directory / "owner-public.pem")
+    {
+        std::filesystem::create_directories(directory);
+        auto *file = fopen(public_key_path.c_str(), "w");
+        EXPECT_NE(file, nullptr);
+        EXPECT_EQ(PEM_write_PUBKEY(file, owner.get()), 1);
+        fclose(file);
+    }
+
+    ~Fixture() { std::filesystem::remove_all(directory); }
+
+    endstone::runtime::localbot::Config config(bool enabled = true) const
+    {
+        endstone::runtime::localbot::Config result;
+        result.enabled = enabled;
+        result.public_key_file = public_key_path.string();
+        return result;
+    }
+
+    Json identityPayload(std::string cpk = {}) const
+    {
+        return {
+            {"iss", "endbot://local-bot"},
+            {"aud", "endstone://local-bot"},
+            {"sub", "63572362-0c83-5f0a-8cec-e1b788101798"},
+            {"xname", "CppBot"},
+            {"cpk", cpk.empty() ? publicKeyBase64(client.get()) : cpk},
+            {"jti", "526290d1-a78e-4a18-b32e-8c0d14e10850"},
+            {"iat", kNow},
+            {"nbf", kNow - 1},
+            {"exp", kNow + 60},
+        };
+    }
+
+    Json clientPayload() const
+    {
+        return {{"ThirdPartyName", "CppBot"}, {"SelfSignedId", "63572362-0c83-5f0a-8cec-e1b788101798"}};
+    }
+
+    std::chrono::system_clock::time_point now() const { return std::chrono::system_clock::time_point(std::chrono::seconds(kNow)); }
+
+    PkeyPtr owner;
+    PkeyPtr client;
+    PkeyPtr alternate;
+    std::filesystem::path directory;
+    std::filesystem::path public_key_path;
+};
+
+TEST(LocalBotAuthTest, AcceptsValidIdentityAndRejectsReplay)
+{
+    Fixture fixture;
+    endstone::runtime::localbot::Verifier verifier(fixture.config());
+    const auto identity = signJwt(fixture.identityPayload(), fixture.owner.get());
+    const auto client_data = signJwt(fixture.clientPayload(), fixture.client.get());
+    const auto first = verifier.verify(identity, client_data, fixture.now());
+    EXPECT_TRUE(first.candidate);
+    ASSERT_TRUE(first.accepted) << first.error;
+    EXPECT_EQ(first.identity.name, "CppBot");
+    EXPECT_EQ(first.identity.subject, "63572362-0c83-5f0a-8cec-e1b788101798");
+    const auto replay = verifier.verify(identity, client_data, fixture.now());
+    EXPECT_FALSE(replay.accepted);
+    EXPECT_EQ(replay.error, "local identity token was already used");
+}
+
+TEST(LocalBotAuthTest, RejectsWrongOwnerSignature)
+{
+    Fixture fixture;
+    endstone::runtime::localbot::Verifier verifier(fixture.config());
+    const auto result = verifier.verify(signJwt(fixture.identityPayload(), fixture.alternate.get()),
+                                        signJwt(fixture.clientPayload(), fixture.client.get()), fixture.now());
+    EXPECT_FALSE(result.accepted);
+    EXPECT_TRUE(result.candidate);
+    EXPECT_EQ(result.error, "owner signature is invalid");
+}
+
+TEST(LocalBotAuthTest, RejectsWrongIssuerAndExpiredToken)
+{
+    Fixture fixture;
+    auto wrong_issuer = fixture.identityPayload();
+    wrong_issuer["iss"] = "endbot://wrong";
+    endstone::runtime::localbot::Verifier issuer_verifier(fixture.config());
+    auto result = issuer_verifier.verify(signJwt(wrong_issuer, fixture.owner.get()),
+                                         signJwt(fixture.clientPayload(), fixture.client.get()), fixture.now());
+    EXPECT_FALSE(result.accepted);
+    EXPECT_FALSE(result.candidate);
+    EXPECT_EQ(result.error, "issuer does not match local-bot-auth configuration");
+
+    auto expired = fixture.identityPayload();
+    expired["iat"] = kNow - 300;
+    expired["nbf"] = kNow - 300;
+    expired["exp"] = kNow - 180;
+    endstone::runtime::localbot::Verifier expiry_verifier(fixture.config());
+    result = expiry_verifier.verify(signJwt(expired, fixture.owner.get()),
+                                    signJwt(fixture.clientPayload(), fixture.client.get()), fixture.now());
+    EXPECT_FALSE(result.accepted);
+    EXPECT_TRUE(result.candidate);
+    EXPECT_EQ(result.error, "local identity has expired");
+}
+
+TEST(LocalBotAuthTest, RejectsClientKeyAndClaimBindingFailures)
+{
+    Fixture fixture;
+    endstone::runtime::localbot::Verifier key_verifier(fixture.config());
+    auto result = key_verifier.verify(signJwt(fixture.identityPayload(publicKeyBase64(fixture.alternate.get())),
+                                              fixture.owner.get()),
+                                      signJwt(fixture.clientPayload(), fixture.client.get()), fixture.now());
+    EXPECT_FALSE(result.accepted);
+    EXPECT_EQ(result.error, "client-data cpk signature is invalid");
+
+    auto wrong_name = fixture.clientPayload();
+    wrong_name["ThirdPartyName"] = "OtherBot";
+    endstone::runtime::localbot::Verifier name_verifier(fixture.config());
+    result = name_verifier.verify(signJwt(fixture.identityPayload(), fixture.owner.get()),
+                                  signJwt(wrong_name, fixture.client.get()), fixture.now());
+    EXPECT_FALSE(result.accepted);
+    EXPECT_EQ(result.error, "client-data name is not bound to the local identity");
+}
+
+TEST(LocalBotAuthTest, DisabledConfigurationCannotAuthorize)
+{
+    Fixture fixture;
+    endstone::runtime::localbot::Verifier verifier(fixture.config(false));
+    const auto result = verifier.verify("not-a-token", "not-a-token", fixture.now());
+    EXPECT_FALSE(result.accepted);
+    EXPECT_EQ(result.error, "local-bot-auth is disabled");
+}
+
+TEST(LocalBotAuthTest, MalformedTokenIsNotRoutedAsLocal)
+{
+    Fixture fixture;
+    endstone::runtime::localbot::Verifier verifier(fixture.config());
+    const auto result = verifier.verify("not-a-token", "not-a-token", fixture.now());
+    EXPECT_FALSE(result.candidate);
+    EXPECT_FALSE(result.accepted);
+    EXPECT_EQ(result.error, "token must have three non-empty compact JWS parts");
+}
+
+}  // namespace
