{
  "namespace": "server_form",

  "main_screen_content": {
    "type": "panel",
    "size": ["100%", "100%"],
    "controls": [
      {
        "server_form_factory": {
          "type": "factory",
          "control_ids": {
            "long_form": "@server_form.endbot_long_form",
            "custom_form": "@server_form.endbot_custom_form"
          }
        }
      }
    ]
  },

  "endbot_long_form@server_form.long_form": {
    "size": ["100% - 40px", "100% - 24px"],
    "max_size": [420, 300],
    "$child_control": "server_form.endbot_long_form_panel"
  },

  "endbot_long_form_panel@server_form.long_form_panel": {
    "controls": [
      {
        "scrolling_panel@common.scrolling_panel": {
          "anchor_to": "top_left",
          "anchor_from": "top_left",
          "$show_background": false,
          "size": ["100%", "100%"],
          "$scrolling_content": "server_form.endbot_long_form_scrolling_content",
          "$scroll_size": [5, "100% - 4px"],
          "$scrolling_pane_size": ["100% - 4px", "100% - 2px"],
          "$scrolling_pane_offset": [2, 0],
          "$scroll_bar_right_padding_size": [0, 0]
        }
      }
    ]
  },

  "endbot_long_form_scrolling_content@server_form.long_form_scrolling_content": {
    "controls": [
      {
        "label_offset_panel": {
          "type": "panel",
          "size": ["100%", "100%c"],
          "controls": [
            {
              "main_label": {
                "type": "label",
                "offset": [2, 2],
                "color": "$main_header_text_color",
                "size": ["100%", "default"],
                "anchor_from": "top_left",
                "anchor_to": "top_left",
                "text": "#form_text"
              }
            }
          ]
        }
      },
      {
        "padding": {
          "type": "panel",
          "size": ["100%", 4]
        }
      },
      {
        "wrapping_panel": {
          "type": "panel",
          "size": ["100%", "100%c"],
          "controls": [
            {
              "long_form_dynamic_buttons_panel@server_form.endbot_long_form_buttons": {}
            }
          ]
        }
      }
    ]
  },

  "endbot_long_form_buttons@server_form.long_form_dynamic_buttons_panel": {
    "factory": {
      "name": "buttons",
      "control_ids": {
        "button": "server_form.endbot_dynamic_button",
        "label": "@server_form.dynamic_label",
        "header": "@server_form.dynamic_header",
        "divider": "@settings_common.option_group_section_divider"
      }
    }
  },

  "endbot_dynamic_button@server_form.dynamic_button": {
    "size": ["100%", 24],
    "controls": [
      {
        "panel_name": {
          "type": "panel",
          "size": [26, "100%c"],
          "bindings": [
            {
              "binding_type": "view",
              "source_control_name": "image",
              "resolve_sibling_scope": true,
              "source_property_name": "(not (#texture = ''))",
              "target_property_name": "#visible"
            }
          ],
          "controls": [
            {
              "image": {
                "type": "image",
                "layer": 2,
                "size": [24, 24],
                "bindings": [
                  {
                    "binding_name": "#form_button_texture",
                    "binding_name_override": "#texture",
                    "binding_type": "collection",
                    "binding_collection_name": "form_buttons"
                  },
                  {
                    "binding_name": "#form_button_texture_file_system",
                    "binding_name_override": "#texture_file_system",
                    "binding_type": "collection",
                    "binding_collection_name": "form_buttons"
                  },
                  {
                    "binding_type": "view",
                    "source_property_name": "(not ((#texture = '') or (#texture = 'loading')))",
                    "target_property_name": "#visible"
                  }
                ]
              }
            }
          ]
        }
      },
      {
        "form_button@common_buttons.light_text_button": {
          "$pressed_button_name": "button.form_button_click",
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "size": ["fill", 24],
          "$button_text": "#form_button_text",
          "$button_text_binding_type": "collection",
          "$button_text_grid_collection_name": "form_buttons",
          "$button_text_max_size": ["100%", 20],
          "bindings": [
            {
              "binding_type": "collection_details",
              "binding_collection_name": "form_buttons"
            }
          ]
        }
      }
    ]
  },

  "endbot_custom_form@server_form.custom_form": {
    "size": ["100% - 40px", "100% - 24px"],
    "max_size": [420, 300],
    "$child_control": "server_form.endbot_custom_form_panel"
  },

  "endbot_custom_form_panel@server_form.custom_form_panel": {
    "$scrolling_content": "server_form.endbot_custom_form_scrolling_content"
  },

  "endbot_custom_form_scrolling_content@server_form.custom_form_scrolling_content": {
    "controls": [
      {
        "generated_form@server_form.endbot_generated_contents": {}
      },
      {
        "submit_button@common_buttons.light_text_button": {
          "$pressed_button_name": "button.submit_custom_form",
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "size": ["100%", 28],
          "$button_text": "#submit_text",
          "$button_text_binding_type": "global",
          "$button_binding_condition": "once",
          "bindings": [
            {
              "binding_name": "#submit_button_visible",
              "binding_name_override": "#visible"
            }
          ]
        }
      }
    ]
  },

  "endbot_generated_contents@server_form.generated_contents": {
    "factory": {
      "name": "buttons",
      "control_ids": {
        "label": "@server_form.custom_label",
        "toggle": "@server_form.custom_toggle",
        "slider": "@server_form.custom_slider",
        "step_slider": "@server_form.custom_step_slider",
        "dropdown": "@server_form.custom_dropdown",
        "input": "@server_form.endbot_input",
        "header": "@server_form.custom_header",
        "divider": "@settings_common.option_group_section_divider",
        "multiselect": "@server_form.custom_multiselect"
      }
    }
  },

  "endbot_input": {
    "type": "stack_panel",
    "orientation": "vertical",
    "size": ["100%", "100%c"],
    "controls": [
      {
        "single_line": {
          "type": "panel",
          "size": ["100%", "100%c"],
          "bindings": [
            {
              "binding_name": "#custom_text",
              "binding_type": "collection",
              "binding_collection_name": "custom_form"
            },
            {
              "binding_type": "view",
              "source_property_name": "((#custom_text - '§e§b§o§t§r') = #custom_text)",
              "target_property_name": "#visible"
            }
          ],
          "controls": [
            {
              "input@server_form.custom_input": {}
            }
          ]
        }
      },
      {
        "multi_line": {
          "type": "panel",
          "size": ["100%", "100%c"],
          "bindings": [
            {
              "binding_name": "#custom_text",
              "binding_type": "collection",
              "binding_collection_name": "custom_form"
            },
            {
              "binding_type": "view",
              "source_property_name": "(not ((#custom_text - '§e§b§o§t§r') = #custom_text))",
              "target_property_name": "#visible"
            }
          ],
          "controls": [
            {
              "input@server_form.endbot_multiline_input": {}
            }
          ]
        }
      }
    ]
  },

  "endbot_multiline_input@server_form.custom_input": {
    "$max_text_edit_length": 32768,
    "$control_name": "server_form.endbot_multiline_control"
  },

  "endbot_multiline_control@common.scrollable_multiline_text_edit_box": {
    "size": ["100%", 150],
    "max_length": "$max_text_edit_length",
    "$text_edit_box_content_binding_name": "$option_binding_name",
    "$text_edit_box_binding_collection_name": "$option_binding_name",
    "$text_edit_box_binding_type": "global",
    "$text_box_enabled_binding_name": "$option_enabled_binding_name",
    "enabled": "$enabled",
    "$place_holder_text": "$option_place_holder_text",
    "$text_box_tts_header": "$option_label",
    "variables": [
      {
        "requires": "(not $option_enabled_binding_name or not $enabled)",
        "$text_box_enabled_binding_name": "#not_data_bound",
        "$text_edit_box_enabled_binding_type": "none"
      }
    ]
  }
}
