+namespace {
+endstone::runtime::ownerbot::Verifier *getOwnerbotVerifier()
+{
+    static std::unique_ptr<endstone::runtime::ownerbot::Verifier> verifier;
+    static std::once_flag once;
+    std::call_once(once, [] {
+        auto config = endstone::runtime::ownerbot::loadConfig();
+        if (config.enabled) {
+            verifier = std::make_unique<endstone::runtime::ownerbot::Verifier>(std::move(config));
+            endstone::core::EndstoneServer::getInstance().getLogger().info(
+                "Local ownerbot authentication is enabled for issuer '{}'.", verifier->getConfig().issuer);
+        }
+    });
+    return verifier.get();
+}
+
+std::string getCompactClientDataToken(const WebToken &token)
+{
+    return token.getEncodedHeader() + "." + token.getEncodedData() + "." + token.getEncodedSignature();
+}
+}  // namespace
 
 void ServerNetworkHandler::disconnectClientWithMessage(const NetworkIdentifier &id, const SubClientId sub_id,
                                                        const Connection::DisconnectFailReason reason,
@@ -148,10 +173,45 @@ std::optional<PlayerAuthenticationInfo> ServerNetworkHandler::_validateLoginPack
         return std::nullopt;
     }
 
-    // Run the original logics first so invalid login attempts will be rejected right away.
-    auto auth_info = ENDSTONE_HOOK_CALL_ORIGINAL(&ServerNetworkHandler::_validateLoginPacket, this, source, packet);
+    std::optional<PlayerAuthenticationInfo> auth_info;
+    try {
+        if (auto *verifier = getOwnerbotVerifier()) {
+            const auto &request = *packet.payload.connection_request;
+            const auto verification = verifier->verify(request._getGameServerToken().value,
+                                                       getCompactClientDataToken(request._getRawRequest()));
+            if (verification.accepted) {
+                const auto &identity = verification.identity;
+                PlayerAuthenticationInfo local_info{};
+                local_info.xbox_live_name = identity.name;
+                local_info.best_display_name = identity.name;
+                local_info.public_key = identity.client_public_key;
+                local_info.authenticated_uuid = mce::UUID::fromString(identity.subject);
+                local_info.is_host = false;
+                local_info.is_local = true;
+                server.getLogger().info("Accepted local ownerbot '{}' ({}) from issuer '{}'.", identity.name,
+                                        identity.subject, identity.issuer);
+                auth_info = std::move(local_info);
+            }
+            else if (verification.candidate) {
+                server.getLogger().info("Local ownerbot Login rejected: {}.", verification.error);
+            }
+        }
+    }
+    catch (const std::exception &error) {
+        server.getLogger().error("Local ownerbot authentication configuration failed: {}", error.what());
+    }
+
+    // The stock validator sends a disconnect as part of rejecting a Login, so
+    // an accepted local token must be routed before that destructive failure
+    // path. Every non-local or invalid token still takes the complete vanilla
+    // Microsoft validation path unchanged.
     if (!auth_info) {
-        return auth_info;
+        auth_info = ENDSTONE_HOOK_CALL_ORIGINAL(&ServerNetworkHandler::_validateLoginPacket, this, source, packet);
+        // A rejected remote Login has already been disconnected by the stock validator.
+        // Preserve upstream's early return before any code dereferences auth_info.
+        if (!auth_info) {
+            return auth_info;
+        }
     }
 
     const auto &info = *auth_info;
diff --git a/src/endstone/runtime/local_ownerbot_auth.cpp b/src/endstone/runtime/local_ownerbot_auth.cpp
