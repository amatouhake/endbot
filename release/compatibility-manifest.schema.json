{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/amatouhake/endbot/blob/main/release/compatibility-manifest.schema.json",
  "title": "Endbot compatibility manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "endbot",
    "endstone",
    "bds",
    "endbot_patch_revision",
    "tested_safety_conditions",
    "historical_validation",
    "bds_binary_included"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "endbot": {
      "type": "object",
      "required": ["version", "revision"],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      },
      "additionalProperties": false
    },
    "endstone": {
      "type": "object",
      "required": ["tag", "commit", "package_version"],
      "properties": {
        "tag": { "type": "string", "minLength": 1 },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "package_version": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+){2}\\+endbot\\.[0-9]+$" }
      },
      "additionalProperties": false
    },
    "bds": {
      "type": "object",
      "required": ["version", "build", "protocol"],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "build": { "type": "integer", "minimum": 1 },
        "protocol": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "endbot_patch_revision": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "tested_safety_conditions": {
      "type": "object",
      "required": [
        "online_mode",
        "allow_cheats",
        "experiments_required",
        "actual_xbox_achievement_unlock_observed",
        "actual_xbox_achievement_unlock_scope",
        "m2_actual_xbox_achievement_unlock_observed",
        "m2_actual_xbox_achievement_unlock_scope"
      ],
      "properties": {
        "online_mode": { "const": true },
        "allow_cheats": { "const": false },
        "experiments_required": { "const": false },
        "actual_xbox_achievement_unlock_observed": { "const": false },
        "actual_xbox_achievement_unlock_scope": { "const": "m0_bot_ping" },
        "m2_actual_xbox_achievement_unlock_observed": { "const": false },
        "m2_actual_xbox_achievement_unlock_scope": { "const": "representative_m2_controls" }
      },
      "additionalProperties": false
    },
    "historical_validation": {
      "type": "object",
      "required": ["patched_endstone_package_version", "m0", "m2"],
      "properties": {
        "patched_endstone_package_version": { "const": "0.11.11+endbot.1" },
        "m0": {
          "type": "object",
          "required": ["observed", "scope", "endbot_revision"],
          "properties": {
            "observed": { "const": true },
            "scope": { "const": "m0_bot_ping" },
            "endbot_revision": { "const": "f509ac4e8677d9bc870b341f001b8e42f512df97" }
          },
          "additionalProperties": false
        },
        "m2": {
          "type": "object",
          "required": ["observed", "scope"],
          "properties": {
            "observed": { "const": true },
            "scope": { "const": "representative_m2_controls" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "bds_binary_included": { "const": false }
  }
}
