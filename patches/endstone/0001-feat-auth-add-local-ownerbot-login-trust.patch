index 0000000000000000000000000000000000000000..f8f99b021e467a4237b66dfc4a333f255af57115
--- /dev/null
+++ b/src/endstone/runtime/local_ownerbot_auth.cpp
@@ -0,0 +1,279 @@
+// Copyright (c) 2026, The Endstone Project contributors.
+// SPDX-License-Identifier: Apache-2.0
+
+#include "endstone/runtime/local_ownerbot_auth.h"
+
+#include <algorithm>
+#include <array>
+#include <fstream>
+#include <limits>
+#include <regex>
+#include <stdexcept>
+#include <string_view>
+#include <vector>
+
+#include <nlohmann/json.hpp>
+#include <openssl/bio.h>
+#include <openssl/bn.h>
+#include <openssl/core_names.h>
+#include <openssl/ec.h>
+#include <openssl/evp.h>
+#include <openssl/pem.h>
+#include <openssl/x509.h>
+#include <toml++/toml.h>
+
+namespace endstone::runtime::ownerbot {
+namespace {
+
+using Json = nlohmann::json;
+using BioPtr = std::unique_ptr<BIO, decltype(&BIO_free)>;
+using MdCtxPtr = std::unique_ptr<EVP_MD_CTX, decltype(&EVP_MD_CTX_free)>;
+using EcdsaSigPtr = std::unique_ptr<ECDSA_SIG, decltype(&ECDSA_SIG_free)>;
+
+struct Jwt {
+    std::string encoded_header;
+    std::string encoded_payload;
+    std::vector<unsigned char> signature;
+    Json header;
+    Json payload;
+};
+
+std::vector<unsigned char> decodeBase64Url(std::string value)
+{
+    for (auto &c : value) {
+        if (c == '-') c = '+';
+        else if (c == '_') c = '/';
+    }
+    if (value.size() % 4 == 1) throw std::invalid_argument("invalid base64url length");
+    while (value.size() % 4 != 0) value.push_back('=');
+
+    std::vector<unsigned char> decoded((value.size() / 4) * 3);
+    const auto length = EVP_DecodeBlock(decoded.data(), reinterpret_cast<const unsigned char *>(value.data()),
+                                        static_cast<int>(value.size()));
+    if (length < 0) throw std::invalid_argument("invalid base64url data");
+    auto padding = 0;
+    if (!value.empty() && value.back() == '=') ++padding;
+    if (value.size() > 1 && value[value.size() - 2] == '=') ++padding;
+    decoded.resize(static_cast<std::size_t>(length - padding));
+    return decoded;
+}
+
+Jwt parseJwt(const std::string &compact)
+{
+    const auto first = compact.find('.');
+    const auto second = first == std::string::npos ? std::string::npos : compact.find('.', first + 1);
+    if (first == std::string::npos || second == std::string::npos || compact.find('.', second + 1) != std::string::npos ||
+        first == 0 || second == first + 1 || second + 1 == compact.size()) {
+        throw std::invalid_argument("token must have three non-empty compact JWS parts");
+    }
+    Jwt result;
+    result.encoded_header = compact.substr(0, first);
+    result.encoded_payload = compact.substr(first + 1, second - first - 1);
+    result.signature = decodeBase64Url(compact.substr(second + 1));
+    const auto header = decodeBase64Url(result.encoded_header);
+    const auto payload = decodeBase64Url(result.encoded_payload);
+    result.header = Json::parse(header.begin(), header.end());
+    result.payload = Json::parse(payload.begin(), payload.end());
+    if (!result.header.is_object() || !result.payload.is_object()) {
+        throw std::invalid_argument("token header and payload must be JSON objects");
+    }
+    return result;
+}
+
+bool isP384(EVP_PKEY *key)
+{
+    if (!key || !EVP_PKEY_is_a(key, "EC")) return false;
+    std::array<char, 32> group{};
+    std::size_t length = 0;
+    return EVP_PKEY_get_utf8_string_param(key, OSSL_PKEY_PARAM_GROUP_NAME, group.data(), group.size(), &length) == 1 &&
+           std::string_view(group.data(), length) == "secp384r1";
+}
+
+std::unique_ptr<EVP_PKEY, Verifier::PkeyDeleter> readPublicKey(const std::string &path)
+{
+    BioPtr bio(BIO_new_file(path.c_str(), "r"), BIO_free);
+    if (!bio) throw std::runtime_error("could not open public key file: " + path);
+    std::unique_ptr<EVP_PKEY, Verifier::PkeyDeleter> key(PEM_read_bio_PUBKEY(bio.get(), nullptr, nullptr, nullptr));
+    if (!isP384(key.get())) throw std::runtime_error("owner public key must be an EC P-384 PEM public key");
+    return key;
+}
+
+std::unique_ptr<EVP_PKEY, Verifier::PkeyDeleter> readDerPublicKey(const std::string &encoded)
+{
+    const auto der = decodeBase64Url(encoded);
+    const unsigned char *position = der.data();
+    std::unique_ptr<EVP_PKEY, Verifier::PkeyDeleter> key(
+        d2i_PUBKEY(nullptr, &position, static_cast<long>(der.size())));
+    if (!key || position != der.data() + der.size() || !isP384(key.get())) {
+        throw std::invalid_argument("cpk must be a base64 DER EC P-384 public key");
+    }
+    return key;
+}
+
+std::vector<unsigned char> rawEcdsaToDer(const std::vector<unsigned char> &raw)
+{
+    if (raw.size() != 96) throw std::invalid_argument("ES384 signature must contain 96 raw bytes");
+    EcdsaSigPtr signature(ECDSA_SIG_new(), ECDSA_SIG_free);
+    if (!signature) throw std::runtime_error("could not allocate ECDSA signature");
+    auto *r = BN_bin2bn(raw.data(), 48, nullptr);
+    auto *s = BN_bin2bn(raw.data() + 48, 48, nullptr);
+    if (!r || !s || ECDSA_SIG_set0(signature.get(), r, s) != 1) {
+        BN_free(r);
+        BN_free(s);
+        throw std::runtime_error("could not decode ECDSA signature");
+    }
+    const auto length = i2d_ECDSA_SIG(signature.get(), nullptr);
+    if (length <= 0) throw std::runtime_error("could not encode ECDSA signature");
+    std::vector<unsigned char> der(static_cast<std::size_t>(length));
+    auto *position = der.data();
+    if (i2d_ECDSA_SIG(signature.get(), &position) != length) throw std::runtime_error("could not encode ECDSA signature");
+    return der;
+}
+
+bool verifySignature(const Jwt &jwt, EVP_PKEY *key)
+{
+    if (jwt.header.value("alg", "") != "ES384") return false;
+    const auto signing_input = jwt.encoded_header + "." + jwt.encoded_payload;
+    const auto signature = rawEcdsaToDer(jwt.signature);
+    MdCtxPtr context(EVP_MD_CTX_new(), EVP_MD_CTX_free);
+    if (!context || EVP_DigestVerifyInit(context.get(), nullptr, EVP_sha384(), nullptr, key) != 1) {
+        throw std::runtime_error("could not initialize ES384 verification");
+    }
+    return EVP_DigestVerify(context.get(), signature.data(), signature.size(),
+                            reinterpret_cast<const unsigned char *>(signing_input.data()), signing_input.size()) == 1;
+}
+
+std::int64_t integerClaim(const Json &payload, const char *name)
+{
+    const auto it = payload.find(name);
+    if (it == payload.end() || !it->is_number_integer()) throw std::invalid_argument(std::string("missing integer claim: ") + name);
+    return it->get<std::int64_t>();
+}
+
+std::string stringClaim(const Json &payload, const char *name)
+{
+    const auto it = payload.find(name);
+    if (it == payload.end() || !it->is_string()) throw std::invalid_argument(std::string("missing string claim: ") + name);
+    return it->get<std::string>();
+}
+
+bool audienceMatches(const Json &payload, const std::string &audience)
+{
+    const auto it = payload.find("aud");
+    if (it == payload.end()) return false;
+    if (it->is_string()) return it->get<std::string>() == audience;
+    if (!it->is_array()) return false;
+    return std::ranges::any_of(*it, [&](const Json &value) { return value.is_string() && value == audience; });
+}
+
+bool validUuid(const std::string &value)
+{
+    static const std::regex pattern(
+        R"(^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$)");
+    return std::regex_match(value, pattern);
+}
+
+}  // namespace
+
+Config loadConfig(const std::string &path)
+{
+    Config config;
+    const auto table = toml::parse_file(path);
+    config.enabled = table.at_path("local-bot-auth.enabled").value_or(false);
+    config.issuer = table.at_path("local-bot-auth.issuer").value_or(config.issuer);
+    config.audience = table.at_path("local-bot-auth.audience").value_or(config.audience);
+    config.public_key_file = table.at_path("local-bot-auth.public-key-file").value_or(config.public_key_file);
+    config.clock_skew_seconds = table.at_path("local-bot-auth.clock-skew-seconds").value_or(config.clock_skew_seconds);
+    config.max_token_lifetime_seconds =
+        table.at_path("local-bot-auth.max-token-lifetime-seconds").value_or(config.max_token_lifetime_seconds);
+    if (config.issuer.empty() || config.audience.empty() || config.public_key_file.empty()) {
+        throw std::invalid_argument("local-bot-auth issuer, audience, and public-key-file must be non-empty");
+    }
+    if (config.clock_skew_seconds < 0 || config.clock_skew_seconds > 300 || config.max_token_lifetime_seconds < 1 ||
+        config.max_token_lifetime_seconds > 3600) {
+        throw std::invalid_argument("local-bot-auth time limits are outside their safe ranges");
+    }
+    return config;
+}
+
+void Verifier::PkeyDeleter::operator()(EVP_PKEY *key) const
+{
+    EVP_PKEY_free(key);
+}
+
+Verifier::Verifier(Config config) : config_(std::move(config))
+{
+    if (config_.enabled) owner_key_ = readPublicKey(config_.public_key_file);
+}
+
+Verifier::~Verifier() = default;
+
+VerificationResult Verifier::verify(const std::string &identity_token, const std::string &client_data_token,
+                                    std::chrono::system_clock::time_point now)
+{
+    VerificationResult result;
+    if (!config_.enabled) {
+        result.error = "local-bot-auth is disabled";
+        return result;
+    }
+    try {
+        const auto token = parseJwt(identity_token);
+        const auto issuer = stringClaim(token.payload, "iss");
+        if (issuer != config_.issuer) throw std::invalid_argument("issuer does not match local-bot-auth configuration");
+        result.candidate = true;
+        if (!verifySignature(token, owner_key_.get())) throw std::invalid_argument("owner signature is invalid");
+        if (token.header.contains("x5u")) throw std::invalid_argument("local identity must not carry an x5u issuer assertion");
+        if (!audienceMatches(token.payload, config_.audience)) throw std::invalid_argument("audience does not match local-bot-auth configuration");
+        if (token.payload.contains("xid") || token.payload.contains("xuid") || token.payload.contains("XUID")) {
+            throw std::invalid_argument("local identity must not contain Microsoft XUID claims");
+        }
+
+        const auto subject = stringClaim(token.payload, "sub");
+        const auto name = stringClaim(token.payload, "xname");
+        const auto cpk = stringClaim(token.payload, "cpk");
+        const auto token_id = stringClaim(token.payload, "jti");
+        const auto issued_at = integerClaim(token.payload, "iat");
+        const auto not_before = integerClaim(token.payload, "nbf");
+        const auto expires_at = integerClaim(token.payload, "exp");
+        const auto now_seconds = std::chrono::duration_cast<std::chrono::seconds>(now.time_since_epoch()).count();
+        if (!validUuid(subject)) throw std::invalid_argument("subject must be a non-nil RFC 4122 UUID");
+        if (!validUuid(token_id)) throw std::invalid_argument("jti must be a non-nil RFC 4122 UUID");
+        if (name.empty() || name.size() > 64) throw std::invalid_argument("xname must contain between 1 and 64 bytes");
+        if (issued_at > now_seconds + config_.clock_skew_seconds || not_before > now_seconds + config_.clock_skew_seconds) {
+            throw std::invalid_argument("local identity is not yet valid");
+        }
+        if (expires_at <= now_seconds - config_.clock_skew_seconds) throw std::invalid_argument("local identity has expired");
+        if (expires_at <= issued_at || expires_at - issued_at > config_.max_token_lifetime_seconds) {
+            throw std::invalid_argument("local identity lifetime exceeds configured maximum");
+        }
+
+        auto client_key = readDerPublicKey(cpk);
+        const auto client_data = parseJwt(client_data_token);
+        if (!verifySignature(client_data, client_key.get())) throw std::invalid_argument("client-data cpk signature is invalid");
+        if (stringClaim(client_data.payload, "ThirdPartyName") != name) {
+            throw std::invalid_argument("client-data name is not bound to the local identity");
+        }
+        if (stringClaim(client_data.payload, "SelfSignedId") != subject) {
+            throw std::invalid_argument("client-data SelfSignedId is not bound to the local identity");
+        }
+
+        {
+            std::lock_guard lock(replay_mutex_);
+            for (auto it = used_token_ids_.begin(); it != used_token_ids_.end();) {
+                if (it->second <= now_seconds - config_.clock_skew_seconds) it = used_token_ids_.erase(it);
+                else ++it;
+            }
+            if (used_token_ids_.contains(token_id)) throw std::invalid_argument("local identity token was already used");
+            used_token_ids_.emplace(token_id, expires_at);
+        }
+
+        result.accepted = true;
+        result.identity = {issuer, subject, name, cpk, token_id, expires_at};
+    }
+    catch (const std::exception &error) {
+        result.error = error.what();
+    }
+    return result;
+}
+
+}  // namespace endstone::runtime::ownerbot
